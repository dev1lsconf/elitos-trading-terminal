# Elitos Trading Terminal - Environment Variables
# Copia este archivo a .env.local para desarrollo local
# NO comitees .env.local (está en .gitignore)

# ============================================================
# FRONTEND (Vite) - Variables expuestas al cliente (prefijo VITE_)
# ============================================================

# URL base de la API backend (en dev usa proxy de Vite /api -> localhost:5000)
# En producción: URL completa del backend desplegado (ej: https://elitos-api.onrender.com)
VITE_API_URL=

# ============================================================
# BACKEND (Flask) - Solo servidor
# ============================================================

# Puerto del servidor Flask (Render inyecta PORT automáticamente)
# En local: 5000
PORT=5000

# Entorno: development | production
FLASK_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ============================================================
# OPCIONALES - Para futuras funcionalidades
# ============================================================

# Clave secreta para sesiones/cookies (genera una con: python -c "import secrets; print(secrets.token_hex(32))")
# SECRET_KEY=

# Rate limiting (requests por minuto por IP)
# RATE_LIMIT=120

# Cache TTL en segundos para respuestas de API
# CACHE_TTL=60

# ============================================================
# EJEMPLOS POR PLATAFORMA
# ============================================================

# --- RENDER (Backend + Frontend juntos) ---
# No necesitas .env en Render, configura en Dashboard:
# PORT=5000 (auto-inyectado)
# FLASK_ENV=production
# LOG_LEVEL=INFO

# --- VERCEL (Frontend + Serverless Functions) ---
# En Vercel Dashboard > Settings > Environment Variables:
# VITE_API_URL=https://tu-proyecto.vercel.app (las functions están en el mismo dominio)

# --- NETLIFY (Solo Frontend) ---
# En Netlify Dashboard > Site settings > Environment variables:
# VITE_API_URL=https://tu-backend.onrender.com
# (Backend separado en Render/Railway/Fly.io)

# --- DOCKER COMPOSE (Local/Producción) ---
# Ver docker-compose.yml si existe